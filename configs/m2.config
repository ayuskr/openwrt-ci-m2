# =========================================================
# Target
# =========================================================

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y

CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"

# =========================================================
# Host BPF compiler
# =========================================================

CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH="/usr"

# =========================================================
# Kernel BTF
# Required by daed. This creates the vmlinux-btf package.
# =========================================================

CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# =========================================================
# LuCI base
# =========================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y

# =========================================================
# LuCI Chinese language packs
# =========================================================

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

# =========================================================
# Theme
# =========================================================

CONFIG_PACKAGE_luci-theme-aurora=y

# =========================================================
# Base system
# =========================================================

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y

# =========================================================
# IPv6
# =========================================================

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_kmod-ipv6=y

# =========================================================
# PPPoE
# =========================================================

CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# =========================================================
# MosDNS
# =========================================================

CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_mosdns=y

# =========================================================
# Lucky
# =========================================================

CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y

# =========================================================
# GecoosAC
# =========================================================

CONFIG_PACKAGE_luci-app-gecoosac=y

# =========================================================
# Daed
# =========================================================

CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_daed=y

# Rule databases used by the Daed package.
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# =========================================================
# Daed eBPF and transparent-proxy dependencies
# =========================================================

CONFIG_PACKAGE_kmod-bpf=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_tc-tiny=y

# =========================================================
# Firewall offload
# =========================================================

CONFIG_PACKAGE_kmod-nft-offload=y

# =========================================================
# Explicitly remove PassWall, dae and obsolete Daed packages
# =========================================================

# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_microsocks is not set

# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_dae is not set

# CONFIG_PACKAGE_daed-geoip is not set
# CONFIG_PACKAGE_daed-geosite is not set

